# -*- coding: utf-8 -*-
"""
Gerador de Estrutura por Esqueleto v4.27Q — travessa interna garantida
=====================================
Compatível com FreeCAD 1.1/1.2.

FONTES ACEITAS
--------------
- Sketcher::SketchObject com segmentos de reta;
- Draft Line;
- Draft Wire / Polyline;
- outros objetos com Shape.Edges retos.

MODOS
-----
1. Automático:
   - procura um ciclo fechado planar entre as linhas;
   - o ciclo é tratado como LIMITE EXTERNO;
   - linhas restantes viram elementos 3D;
   - linhas perpendiculares ligadas aos vértices do ciclo podem virar pernas
     ancoradas no canto externo.

2. Contorno externo planar:
   - exige um único contorno fechado, convexo e planar;
   - preserva exatamente a dimensão externa desenhada;
   - aplica meia-esquadria automática ou extremidades sem aparar.

3. Rede 3D por eixos:
   - cada linha vira um perfil tubular centrado em seu eixo;
   - não calcula ainda os encontros complexos entre três ou mais barras.

EXEMPLO DE MESA
---------------
Desenhe na bancada Draft:
- um retângulo fechado no plano superior;
- quatro linhas verticais, uma em cada vértice.

No modo Automático:
- o retângulo vira o quadro superior com limite externo preservado;
- as quatro linhas verticais viram pernas;
- se ModoPernasCanto = "Ancorar no canto externo", a seção das pernas cresce
  para dentro do retângulo, sem aumentar a dimensão externa.

PERNAS — MODO SEM JUNTA
-----------------------
- a linha da perna continua representando a altura externa total;
- o corpo tubular da perna começa na face inferior do quadro;
- não há colisão entre quadro e perna;
- tampas opcionais: nenhuma, superior, inferior ou ambas;
- com tampa superior, pode ser criado um toco de fixação:
    * uma tampa estrutural de fechamento;
    * três chapas por padrão, com quantidade configurável;
    * o painel inferior das duas travessas é interrompido na quina;
    * o conjunto fica disponível para parafusamento posterior.

OBSERVAÇÃO
----------
Esta versão segura evita Pad e fusões globais do conjunto. Cada painel é mantido
como Part::Feature independente. O quadro horizontal pode ser gerado com dentes
reais e rasgos complementares. Dentes inferiores são redistribuídos em cada vão livre,
rasgos abertos recebem alívio apenas nos cantos internos, as tampas das pernas
podem ser unidas por dentes nas quatro bordas, as paredes das pernas sobem uma
espessura para encaixar no quadro e as raízes dos dentes das costelas recebem
alívio local para CNC. A V4.25 respeita exatamente a seleção atual: selecionar um Sketch processa somente esse Sketch; selecionar um Grupo processa o conteúdo do Grupo. Em Sketch único, toda linha coplanar que não pertence ao perímetro externo é promovida diretamente a travessa segura.
"""

import math
import FreeCAD as App
import Part
import Sketcher

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None


DOC_NAME = "EstruturaEsqueleto"
PARAM_NAME = "Config_Estrutura_Esqueleto_V42"
ROOT_NAME = "Estrutura_Por_Esqueleto_V427"
GENERATOR_TAG = "Gerador_Estrutura_Esqueleto_v4_27R"
TOL = 1e-6
PLANAR_TOL = 1e-4
ANGLE_TOL = 1e-3
# Pairwise intersection is intentionally bounded.  A regular table sketch
# has only a handful of internal members; hundreds indicate trace fragments
# or an accidental selection of generated geometry, not a usable skeleton.
MAX_PLANAR_MEMBER_CANDIDATES = 80


# =============================================================================
# Utilidades básicas
# =============================================================================

def active_or_new_document():
    doc = App.ActiveDocument
    if doc is None:
        doc = App.newDocument(DOC_NAME)
    return doc


def add_property(obj, type_id, name, group, description, default=None):
    created = False
    if name not in obj.PropertiesList:
        obj.addProperty(type_id, name, group, description)
        created = True
    if created and default is not None:
        setattr(obj, name, default)
    return created


def set_read_only(obj, names):
    for name in names:
        try:
            obj.setEditorMode(name, 1)
        except Exception:
            pass


def mark_generated(obj):
    try:
        if "GeradorEstruturaEsqueleto" not in obj.PropertiesList:
            obj.addProperty(
                "App::PropertyString",
                "GeradorEstruturaEsqueleto",
                "Gerador",
                "Identificador interno do gerador.",
            )
        obj.GeradorEstruturaEsqueleto = GENERATOR_TAG
        obj.setEditorMode("GeradorEstruturaEsqueleto", 2)
    except Exception:
        pass


def qvalue(obj, name):
    value = getattr(obj, name)
    return float(value.Value if hasattr(value, "Value") else value)


def vector_distance(a, b):
    return (a.sub(b)).Length


def vector_unit(vector, message="Vetor de comprimento nulo."):
    length = vector.Length
    if length <= TOL:
        raise ValueError(message)
    # FreeCAD.Vector.multiply altera o próprio vetor.  Esta função é usada para
    # construir bases locais a partir de linhas originais; normalizá-las in
    # place podia zerar a direção que seria reutilizada logo em seguida e
    # fazia pernas/travessas 3D serem descartadas como "vetor nulo".
    return App.Vector(vector).multiply(1.0 / length)


def vector_scaled(vector, factor):
    """Escala uma cópia; nunca altera um eixo já guardado no descritor."""
    return App.Vector(vector).multiply(factor)


def clamp(value, lower, upper):
    return max(lower, min(upper, value))


def matrix_placement(origin, axis_x, axis_y, axis_z):
    """Cria Placement usando os três eixos locais como colunas da matriz."""
    matrix = App.Matrix()

    matrix.A11 = axis_x.x
    matrix.A12 = axis_y.x
    matrix.A13 = axis_z.x
    matrix.A14 = origin.x

    matrix.A21 = axis_x.y
    matrix.A22 = axis_y.y
    matrix.A23 = axis_z.y
    matrix.A24 = origin.y

    matrix.A31 = axis_x.z
    matrix.A32 = axis_y.z
    matrix.A33 = axis_z.z
    matrix.A34 = origin.z

    matrix.A41 = 0.0
    matrix.A42 = 0.0
    matrix.A43 = 0.0
    matrix.A44 = 1.0

    return App.Placement(matrix)


# =============================================================================
# Objeto de parâmetros
# =============================================================================

def set_enum(obj, name, values, default):
    try:
        current = str(getattr(obj, name))
    except Exception:
        current = ""

    setattr(obj, name, values)
    if current in values:
        setattr(obj, name, current)
    else:
        setattr(obj, name, default)


